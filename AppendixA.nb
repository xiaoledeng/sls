Cell[BoxData[
 RowBox[{"VxyzLS", "=", 
  FractionBox[
   RowBox[{"2", " ", "G", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["r", "2"]}], " ", 
       SuperscriptBox["r1", "5"]}], "+", 
      RowBox[{
       SuperscriptBox["r1", "5"], " ", 
       SuperscriptBox["r2", "2"]}], "+", 
      RowBox[{
       RowBox[{"(", 
