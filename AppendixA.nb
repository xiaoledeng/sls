          RowBox[{"(", 
           RowBox[{"r", "-", "r1"}], ")"}], "2"]]}], "]"}]}], "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"r", "-", "r2"}], ")"}], " ", 
