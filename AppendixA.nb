        FractionBox[
         RowBox[{"4", " ", "r", " ", "r2"}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"r", "-", "r2"}], ")"}], "2"]]}], "]"}]}], "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"r", "+", "r1"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", 
         SuperscriptBox["r", "2"]}], "+", 
        SuperscriptBox["r1", "2"]}], ")"}], " ", 
      RowBox[{"EllipticK", "[", 
       RowBox[{"-", 
        FractionBox[
         RowBox[{"4", " ", "r", " ", "r1"}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"r", "-", "r1"}], ")"}], "2"]]}], "]"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"r", "+", "r2"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", 
         SuperscriptBox["r", "2"]}], "+", 
