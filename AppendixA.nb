Cell[BoxData[
 RowBox[{"VxLS", "=", 
  RowBox[{
   FractionBox["1", 
    RowBox[{"3", " ", 
     SuperscriptBox["r", "2"]}]], "G", " ", "\[Rho]", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"r", "-", "r1"}], ")"}], " ", 
