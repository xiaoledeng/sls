Cell[CellGroupData[{
Cell["Readme", "Subsubsection",
 CellChangeTimes->{{3.886240541938459*^9, 3.8862405516520576`*^9}, 
   3.886240768316807*^9, {3.886497633215061*^9, 3.8864976909080553`*^9}, 
   3.8864994237515717`*^9, {3.8865013630638723`*^9, 3.886501380807485*^9}, 
   3.886568614872394*^9, {3.8865898500688677`*^9, 3.886589864385022*^9}, {
   3.8868368098690577`*^9, 3.8868368159872923`*^9}, {3.887167431016021*^9, 
   3.88716743291525*^9}, {3.887254813994649*^9, 3.887254814660623*^9}, {
   3.887273455975004*^9, 
   3.887273457108883*^9}},ExpressionUUID->"9346d1ed-8999-4ecf-9158-\
491c48c31e31"],

Cell[TextData[{
 "1. This Appendix presents other analytical expressions for gravitational \
vector (VxLS and VyLS), gravitational gradient tensor (VxyLS, VxzLS, and \
VyzLS), and gravitational curvature (VxyzLS, VzzxLS, and VzzyLS).\n2. The \
analytical expressions for gravitational curvature (VxxxLS, VxxyLS, VyyxLS, \
and VyyyLS) are not presented because the situation ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "0"], TraditionalForm]],ExpressionUUID->
  "4c81aba3-2ec5-4331-b70e-4d73218e63a3"],
 " occurs.\n3. EllipticE gives the complete elliptic integral ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"E", "(", "m", ")"}], "=", 
    RowBox[{"E", "(", 
     RowBox[{
      FractionBox["\[Pi]", "2"], "\[VerticalSeparator]", "m"}], ")"}]}], 
   TraditionalForm]], "InlineMath",ExpressionUUID->
  "2299924b-7cdc-49ff-9a61-83de581e521b"],
 ".  For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"-", "\[Pi]"}], "/", "2"}], "<", "\[Phi]", "<", 
    RowBox[{"\[Pi]", "/", "2"}]}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"98546eff-01a6-41a9-a194-1813e29fe9b8"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "<", "1"}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "20e431f7-15f3-473f-b8b9-0c55749c62c0"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"E", "(", 
     RowBox[{
      RowBox[{"\[Phi]", "\[VerticalSeparator]"}], "m"}], ")"}], "=", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", "0", "\[Phi]"], 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"m", " \[InvisibleSpace]", 
          RowBox[{
           SuperscriptBox["sin", "2"], "(", "\[Theta]", ")"}]}]}], ")"}], 
       RowBox[{"1", "/", "2"}]], 
      RowBox[{"\[DifferentialD]", "\[Theta]"}]}]}]}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"7792b813-5196-44a0-8a36-8f654c263f3e"],
 ". \n EllipticK gives the complete elliptic integral of the first kind ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"K", "(", "m", ")"}], "\[LongEqual]", 
    RowBox[{"F", "(", 
     RowBox[{
      FractionBox["\[Pi]", "2"], "\[VerticalSeparator]", "m"}], ")"}]}], 
   TraditionalForm]], "InlineMath",ExpressionUUID->
  "60a98815-2f44-4f1d-8ba1-540e716d0880"],
 ". For real ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]], "InlineMath",ExpressionUUID->
  "a008037c-6fe5-497f-be04-e77962eb7146"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"-", "\[Pi]"}], "/", "2"}], "<", "\[Phi]", "<", 
    RowBox[{"\[Pi]", "/", "2"}]}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"1d8b6e21-55e1-4324-ac72-d109580f05da"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"m", " ", 
     RowBox[{
      SuperscriptBox["sin", "2"], "(", "\[Phi]", ")"}]}], "<", "1"}], 
   TraditionalForm]], "InlineMath",ExpressionUUID->
  "ae809f17-518b-4af8-bc33-948713658cf4"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"\[Phi]", "m"},
     "EllipticF"], "\[LongEqual]", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", "0", "\[Phi]"], 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"m", " ", 
          RowBox[{
           SuperscriptBox["sin", "2"], "(", "\[Theta]", ")"}]}]}], ")"}], 
       RowBox[{
        RowBox[{"-", "1"}], "/", "2"}]], 
      RowBox[{"\[DifferentialD]", "\[Theta]"}]}]}]}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"84bd0126-9804-4c5c-ac86-6d388457e13a"],
 ".\nFor certain special arguments, EllipticE and EllipticK automatically \
evaluate to exact values and can be evaluated to arbitrary numerical \
precision."
}], "Text",
 CellChangeTimes->{{3.887167515636952*^9, 3.88716769306709*^9}, {
   3.887167744009897*^9, 3.8871678345962477`*^9}, {3.91077625721524*^9, 
   3.910776292471939*^9}, {3.95630458479818*^9, 3.9563046076607323`*^9}, {
   3.9569816689836187`*^9, 3.9569817317143583`*^9}, {3.957237931346983*^9, 
   3.957237934004136*^9}, {3.9590513227097483`*^9, 3.9590513322915382`*^9}, {
   3.9590523354479933`*^9, 3.959052575440874*^9}, {3.959052606746375*^9, 
   3.959052610417344*^9}, {3.959052680177485*^9, 3.959052734713605*^9}, {
   3.959052785210135*^9, 3.9590529166481247`*^9}, 3.9590529550508413`*^9, {
   3.973850018665551*^9, 
   3.9738500382134037`*^9}},ExpressionUUID->"9f7bf596-84a4-4f71-b1f2-\
fc08f49510d5"]
}, Open  ]],

